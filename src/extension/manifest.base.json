{
  "manifest_version": 3,
  "name": "Discord RPC for YouTube Music",
  "version": "0.1.0",
  "description": "Show what you are listening to on YouTube Music as your Discord Rich Presence.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Discord RPC for YouTube Music"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}
